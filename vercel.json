{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "node scripts/fetch-activities.mjs && npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/jev-rerank.js": { "maxDuration": 15 },
    "api/activities.js": { "maxDuration": 10 },
    "api/pulse.js": { "maxDuration": 10 }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/index" }]
}
