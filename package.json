{
  "name": "running-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An interactive running log \u2014 lifetime mileage, reframed as journeys.",
  "scripts": {
    "dev": "vite",
    "fetch:activities": "node scripts/fetch-activities.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:intent": "node --experimental-strip-types test-intent.mjs",
    "grade": "node --experimental-strip-types scripts/grade-activities.mjs",
    "eval:jev": "node --experimental-strip-types scripts/eval-jev.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
